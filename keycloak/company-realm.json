{
  "realm": "company",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "orders-admin",
        "description": "Create orders (LDAP group cn=orders-admin)"
      },
      {
        "name": "orders-reader",
        "description": "Read orders (LDAP group cn=orders-reader)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "web-app",
      "name": "Web app (OIDC Authorization Code + PKCE, server-side token storage)",
      "enabled": true,
      "publicClient": false,
      "secret": "web-app-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8280/callback"
      ],
      "webOrigins": [
        "http://localhost:8280"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8280/"
      },
      "protocolMappers": [
        {
          "name": "audience orders-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "orders-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "machine-client",
      "name": "Batch job (OAuth 2.0 client credentials, no user)",
      "enabled": true,
      "publicClient": false,
      "secret": "machine-client-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience orders-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "orders-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "http://localhost:8580/saml/metadata",
      "name": "Legacy app (SAML 2.0 service provider)",
      "protocol": "saml",
      "enabled": true,
      "redirectUris": [
        "http://localhost:8580/*"
      ],
      "attributes": {
        "saml.assertion.signature": "true",
        "saml.server.signature": "false",
        "saml.client.signature": "false",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml.authnstatement": "true",
        "saml.force.name.id.format": "true",
        "saml_name_id_format": "username",
        "saml_assertion_consumer_url_post": "http://localhost:8580/saml/acs"
      },
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "saml",
          "protocolMapper": "saml-role-list-mapper",
          "config": {
            "single": "true",
            "attribute.nameformat": "Basic",
            "attribute.name": "Role"
          }
        },
        {
          "name": "email",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "config": {
            "user.attribute": "email",
            "attribute.nameformat": "Basic",
            "attribute.name": "email"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-machine-client",
      "enabled": true,
      "serviceAccountClientId": "machine-client",
      "realmRoles": [
        "default-roles-company",
        "orders-reader"
      ]
    }
  ],
  "components": {
    "org.keycloak.storage.UserStorageProvider": [
      {
        "name": "company-ldap",
        "providerId": "ldap",
        "config": {
          "enabled": [
            "true"
          ],
          "priority": [
            "0"
          ],
          "vendor": [
            "other"
          ],
          "connectionUrl": [
            "ldap://ldap:389"
          ],
          "bindDn": [
            "cn=admin,dc=company,dc=local"
          ],
          "bindCredential": [
            "admin-password"
          ],
          "authType": [
            "simple"
          ],
          "usersDn": [
            "ou=people,dc=company,dc=local"
          ],
          "searchScope": [
            "1"
          ],
          "usernameLDAPAttribute": [
            "uid"
          ],
          "rdnLDAPAttribute": [
            "uid"
          ],
          "uuidLDAPAttribute": [
            "entryUUID"
          ],
          "userObjectClasses": [
            "inetOrgPerson"
          ],
          "editMode": [
            "READ_ONLY"
          ],
          "importEnabled": [
            "true"
          ],
          "syncRegistrations": [
            "false"
          ],
          "trustEmail": [
            "true"
          ],
          "pagination": [
            "false"
          ],
          "cachePolicy": [
            "NO_CACHE"
          ]
        },
        "subComponents": {
          "org.keycloak.storage.ldap.mappers.LDAPStorageMapper": [
            {
              "name": "username",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": [
                  "uid"
                ],
                "user.model.attribute": [
                  "username"
                ],
                "read.only": [
                  "true"
                ],
                "always.read.value.from.ldap": [
                  "true"
                ],
                "is.mandatory.in.ldap": [
                  "true"
                ]
              }
            },
            {
              "name": "email",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": [
                  "mail"
                ],
                "user.model.attribute": [
                  "email"
                ],
                "read.only": [
                  "true"
                ],
                "always.read.value.from.ldap": [
                  "true"
                ],
                "is.mandatory.in.ldap": [
                  "false"
                ]
              }
            },
            {
              "name": "first name",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": [
                  "givenName"
                ],
                "user.model.attribute": [
                  "firstName"
                ],
                "read.only": [
                  "true"
                ],
                "always.read.value.from.ldap": [
                  "true"
                ],
                "is.mandatory.in.ldap": [
                  "true"
                ]
              }
            },
            {
              "name": "last name",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": [
                  "sn"
                ],
                "user.model.attribute": [
                  "lastName"
                ],
                "read.only": [
                  "true"
                ],
                "always.read.value.from.ldap": [
                  "true"
                ],
                "is.mandatory.in.ldap": [
                  "true"
                ]
              }
            },
            {
              "name": "groups to realm roles",
              "providerId": "role-ldap-mapper",
              "config": {
                "roles.dn": [
                  "ou=groups,dc=company,dc=local"
                ],
                "role.name.ldap.attribute": [
                  "cn"
                ],
                "role.object.classes": [
                  "groupOfNames"
                ],
                "membership.ldap.attribute": [
                  "member"
                ],
                "membership.attribute.type": [
                  "DN"
                ],
                "membership.user.ldap.attribute": [
                  "uid"
                ],
                "mode": [
                  "READ_ONLY"
                ],
                "user.roles.retrieve.strategy": [
                  "LOAD_ROLES_BY_MEMBER_ATTRIBUTE"
                ],
                "use.realm.roles.mapping": [
                  "true"
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "identityProviders": [
    {
      "alias": "partner",
      "displayName": "Partner company",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "authorizationUrl": "http://localhost:8180/realms/partner/protocol/openid-connect/auth",
        "tokenUrl": "http://keycloak:8080/realms/partner/protocol/openid-connect/token",
        "jwksUrl": "http://keycloak:8080/realms/partner/protocol/openid-connect/certs",
        "issuer": "http://localhost:8180/realms/partner",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "clientId": "company-broker",
        "clientSecret": "company-broker-secret",
        "clientAuthMethod": "client_secret_post",
        "defaultScope": "openid email profile",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "syncMode": "IMPORT"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "partners can read orders",
      "identityProviderAlias": "partner",
      "identityProviderMapper": "oidc-hardcoded-role-idp-mapper",
      "config": {
        "role": "orders-reader",
        "syncMode": "INHERIT"
      }
    }
  ]
}
